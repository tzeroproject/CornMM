# Supabase Configuration
# Frontend public keys (safe in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Privileged Supabase Key (NEVER expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bunny Stream (Server-Side ONLY)
BUNNY_API_KEY=your-bunny-stream-api-key
BUNNY_LIBRARY_ID=123456
BUNNY_CDN_HOSTNAME=video.yourdomain.b-cdn.net

# UQLOAD (Server-Side ONLY)
UQLOAD_API_KEY=

# DoodStream (Server-Side ONLY)
DOODSTREAM_API_KEY=your-doodstream-api-key

# Streamtape (Server-Side ONLY)
STREAMTAPE_API_LOGIN=
STREAMTAPE_API_KEY=
STREAMTAPE_FOLDER=

# FileMoon (Server-Side ONLY)
FILEMOON_API_TOKEN_1=your-filemoon-account-1-api-token
FILEMOON_API_TOKEN_2=your-filemoon-account-2-api-token
# Legacy Account 1 fallback (optional)
FILEMOON_API_TOKEN=
