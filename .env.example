# Frontend canonical site domain
VITE_SITE_URL=https://cornmm.com

# Supabase Configuration
# Frontend public keys (safe in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Privileged Supabase Key (NEVER expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bunny Stream (Server-Side ONLY)
BUNNY_API_KEY=your-bunny-stream-api-key
BUNNY_LIBRARY_ID=123456
BUNNY_CDN_HOSTNAME=video.yourdomain.b-cdn.net

# UQLOAD (Server-Side ONLY)
UQLOAD_API_KEY=

# DoodStream (Server-Side ONLY)
DOODSTREAM_API_KEY=your-doodstream-api-key

# Streamtape (Server-Side ONLY)
STREAMTAPE_API_LOGIN=
STREAMTAPE_API_KEY=
STREAMTAPE_FOLDER=

# FileMoon (Server-Side ONLY)
FILEMOON_API_TOKEN_1=your-filemoon-account-1-api-token
FILEMOON_API_TOKEN_2=your-filemoon-account-2-api-token
FILEMOON_API_TOKEN_3=your-filemoon-account-3-api-token
FILEMOON_API_TOKEN_4=your-filemoon-account-4-api-token
FILEMOON_API_TOKEN_5=your-filemoon-account-5-api-token
FILEMOON_API_TOKEN_6=your-filemoon-account-6-api-token
FILEMOON_API_TOKEN_7=your-filemoon-account-7-api-token
FILEMOON_API_TOKEN_8=your-filemoon-account-8-api-token
FILEMOON_API_TOKEN_9=your-filemoon-account-9-api-token
FILEMOON_API_TOKEN_10=your-filemoon-account-10-api-token
# Legacy Account 1 fallback (optional)
FILEMOON_API_TOKEN=
